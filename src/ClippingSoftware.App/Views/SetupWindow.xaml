<Window x:Class="ClippingSoftware.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ClippingSoftware.App.Converters"
        mc:Ignorable="d"
        Title="Clipping Software Setup"
        Width="720" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <!-- Plain OS chrome, unlike MainWindow's custom WindowChrome titlebar: this runs once before the app
         proper opens, and a setup dialog that can't be closed by the normal X because a custom chrome
         hook misbehaved would be a bad first impression for zero visual gain. -->

    <Window.Resources>
        <conv:StepVisibilityConverter x:Key="StepVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <Style x:Key="StepHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowTextStyle}">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: fixed brand strip + a step counter, so progress through the wizard is always visible -->
        <Border Grid.Row="0" Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,0,0,1" Padding="24,18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="CLIPPING SOFTWARE" FontSize="18" Foreground="{DynamicResource PaperBrush}"/>
                    <TextBlock Text="FIRST-RUN SETUP" Style="{StaticResource EyebrowTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                           Text="{Binding StepLabel}" Foreground="{DynamicResource TertiaryBrush}"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid>

                <!-- ============ STEP 0: WELCOME + INSTALL CHECK ============ -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=0}">
                    <TextBlock Text="Welcome" Style="{StaticResource StepHeadingStyle}"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}">
                        This app wraps OBS Studio to give you an always-on replay buffer and a global
                        save-clip hotkey - press one key and the last minute of gameplay is saved to your
                        clip library, without recording all day.
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyTextStyle}">
                        Setup takes about a minute. You'll point the app at OBS, paste in the OBS WebSocket
                        password, and choose where clips are saved.
                    </TextBlock>

                    <Border Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1" Padding="14" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="WHAT YOU'LL NEED" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4">
                                - OBS Studio 28 or newer, installed. (The bundled WebSocket server it needs
                                is built in from version 28 onward - no plugin required.)
                            </TextBlock>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,0">
                                - A few minutes of disk space per clip, wherever you choose to save them.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Only rendered on a broken install; a correct one says nothing rather than
                         congratulating the user on files being present. -->
                    <Border Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource TallyRedBrush}"
                            BorderThickness="1" Padding="14" Margin="0,14,0,0"
                            Visibility="{Binding IsFfmpegMissing, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="INSTALL PROBLEM" Foreground="{DynamicResource TallyRedBrush}"
                                       Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0">
                                The bundled ffmpeg tools are missing from this install, so clips can't be
                                processed, trimmed, or thumbnailed. Reinstall using the setup wizard to fix
                                this - you can continue for now, but recording won't produce usable clips.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ STEP 1: OBS LOCATION ============ -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=1}">
                    <TextBlock Text="Find OBS Studio" Style="{StaticResource StepHeadingStyle}"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}">
                        The app launches OBS for you and controls it in the background. Point it at your
                        obs64.exe - this is usually detected automatically.
                    </TextBlock>

                    <TextBlock Text="OBS EXECUTABLE" Style="{StaticResource FieldLabelStyle}"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="BROWSE..." Padding="14,6" Margin="8,0,0,0"
                                Style="{StaticResource OutlinedButtonStyle}" Click="BrowseObs_Click"/>
                        <TextBox Text="{Binding ObsExecutablePath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding ObsExecutableStatus}" Margin="0,8,0,0"
                               Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap"/>

                    <CheckBox Content="Launch OBS automatically when this app starts"
                              IsChecked="{Binding AutoLaunchObs}" Margin="0,18,0,0"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,6,0,0">
                        Leave this on unless you prefer to start OBS yourself. The app minimises OBS to the
                        tray either way.
                    </TextBlock>

                    <Border Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1" Padding="14" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0">
                            Don't have OBS? Install it from obsproject.com, then come back and click Browse.
                            Setup will wait.
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- ============ STEP 2: WEBSOCKET CONNECTION ============ -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=2}">
                    <TextBlock Text="Connect to OBS" Style="{StaticResource StepHeadingStyle}"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}">
                        OBS 28+ ships a WebSocket server with a password already switched on. Copy that
                        password across so this app is allowed to control OBS.
                    </TextBlock>

                    <Border Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1" Padding="14" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="IN OBS STUDIO" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4">
                                1. Open OBS, then go to Tools &gt; WebSocket Server Settings.
                            </TextBlock>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4">
                                2. Tick "Enable WebSocket server". Leave the port at 4455.
                            </TextBlock>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,0">
                                3. Click "Show Connect Info", copy the password, and paste it below.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="HOST" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding ObsWebsocketHost, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PORT" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding ObsWebsocketPort, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding ObsWebsocketPassword, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="TEST CONNECTION" Padding="16,7"
                                Style="{StaticResource OutlinedButtonStyle}"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsNotTestingConnection}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionTestResult}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DimBrush}"/>

                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,14,0,0">
                        You can finish setup without a successful test - the app will keep retrying, and the
                        Settings tab has the same fields if you need to adjust them later.
                    </TextBlock>
                </StackPanel>

                <!-- ============ STEP 3: STORAGE + FINISH ============ -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibility}, ConverterParameter=3}">
                    <TextBlock Text="Where clips are saved" Style="{StaticResource StepHeadingStyle}"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}">
                        These folders are created for you. Recordings holds everything captured by the replay
                        buffer and manual recordings; Exports holds trimmed clips you send out.
                    </TextBlock>

                    <TextBlock Text="RECORDINGS FOLDER" Style="{StaticResource FieldLabelStyle}"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="BROWSE..." Padding="14,6" Margin="8,0,0,0"
                                Style="{StaticResource OutlinedButtonStyle}" Click="BrowseClips_Click"/>
                        <TextBox Text="{Binding ClipStorageFolder, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="EXPORTS FOLDER" Style="{StaticResource FieldLabelStyle}"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="BROWSE..." Padding="14,6" Margin="8,0,0,0"
                                Style="{StaticResource OutlinedButtonStyle}" Click="BrowseExports_Click"/>
                        <TextBox Text="{Binding ExportStorageFolder, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <TextBlock Text="CLIP LENGTH (SECONDS)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding ReplayBufferLengthSeconds, UpdateSourceTrigger=PropertyChanged}" Width="120"
                             HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0">
                        How much gameplay a saved clip covers. 60 seconds is a good default - longer buffers
                        use more memory, since OBS keeps the whole window in RAM.
                    </TextBlock>

                    <Border Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="YOUR HOTKEYS" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4">
                                Ctrl+Alt+F10 - save the last minute as a clip
                            </TextBlock>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,0">
                                Ctrl+Alt+F11 - start / stop a full recording
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,14,0,0">
                        Both can be rebound later from the Settings tab. Click Finish to save and start the app.
                    </TextBlock>

                    <TextBlock Text="{Binding FinishError}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TallyRedBrush}"/>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Footer nav. Next and Finish swap places rather than both being present-but-disabled, so the
             one action that moves the wizard forward is always the same button in the same spot. -->
        <Border Grid.Row="2" Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="CANCEL" Padding="18,8"
                        Style="{StaticResource OutlinedButtonStyle}" Command="{Binding CancelCommand}"/>
                <Button DockPanel.Dock="Right" Content="FINISH" Padding="24,8" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding FinishCommand}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}"/>
                <Button DockPanel.Dock="Right" Content="NEXT" Padding="24,8" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NextCommand}"
                        Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisibility}}"/>
                <Button DockPanel.Dock="Right" Content="BACK" Padding="18,8"
                        Style="{StaticResource OutlinedButtonStyle}" Command="{Binding BackCommand}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
