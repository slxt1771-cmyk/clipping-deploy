<UserControl x:Class="ClippingSoftware.App.Views.TagManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ClippingSoftware.App.Converters"
             xmlns:vm="clr-namespace:ClippingSoftware.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: tag list, create/recolor/rename/delete. Same master-list shape as GameProfilesView. -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="TAG-SYS // TG-001" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="15"/>
                <TextBlock Margin="0,3,0,0" Style="{StaticResource EyebrowTextStyle}">
                    <Run Text="MODULE_ID: TAGS"/>
                    <Run Text="  ENTRIES: "/>
                    <Run Text="{Binding Tags.Count, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TagViewModel}">
                            <Border Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                                    BorderThickness="1" Padding="8" Margin="0,0,0,8" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <Border DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0"
                                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="Save name/color"
                                                    Command="{Binding DataContext.SaveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Width="12" Height="10" Stretch="Uniform" Stroke="{DynamicResource PaperBrush}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M1,5 L4,8 L11,1"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="Delete tag"
                                                    Command="{Binding DataContext.DeleteTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Width="12" Height="14" Stretch="Uniform" Stroke="{DynamicResource TallyRedBrush}" StrokeThickness="1.3"
                                                      StrokeLineJoin="Round"
                                                      Data="M1,4 L13,4 M5,4 L5,1.5 L9,1.5 L9,4 M3,4 L3,14 L11,14 L11,4 M5.5,7 L5.5,11 M8.5,7 L8.5,11"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                    </DockPanel>
                                    <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- New tag form -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="NEW TAG" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}" Margin="0,0,0,4"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="ADD" Padding="10,4" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddTagCommand}"/>
                        <Border DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                Background="{Binding NewTagColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                        <TextBox Text="{Binding NewTagColorHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TallyRedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right: the selected tag's clip checklist - this is where assignment actually happens. -->
        <Grid Grid.Column="2">
            <TextBlock Text="Select a tag on the left to assign it to clips." Foreground="{DynamicResource DimBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                       Visibility="{Binding HasSelectedTag, Converter={StaticResource InverseBoolToVis}}"/>

            <Grid Visibility="{Binding HasSelectedTag, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="0,0,0,10" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="15">
                    <Run Text="ASSIGN: "/>
                    <Run Text="{Binding SelectedTag.Name, Mode=OneWay}"/>
                </TextBlock>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ClipRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TagClipRowViewModel}">
                                <CheckBox Content="{Binding FileNameTag}" IsChecked="{Binding IsAssigned}"
                                          FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,0,0,8"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
