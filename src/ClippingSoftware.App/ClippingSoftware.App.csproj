<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClippingSoftware.Core\ClippingSoftware.Core.csproj" />
    <ProjectReference Include="..\ClippingSoftware.Data\ClippingSoftware.Data.csproj" />
    <ProjectReference Include="..\ClippingSoftware.Shared\ClippingSoftware.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\tray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- WPF normally auto-generates Main() for you; overriding it (App.xaml.cs now has an explicit one) is
       required so VelopackApp.Build().Run() can run before anything else at startup, per Velopack's own
       WPF integration requirements - it needs to intercept command-line args used internally during
       install/update/uninstall before WPF (or the rest of this app) ever sees them. -->
  <PropertyGroup>
    <StartupObject>ClippingSoftware.App.App</StartupObject>
  </PropertyGroup>

  <!-- App.xaml must not also be treated as an ApplicationDefinition (which auto-generates a Main that
       would conflict with the explicit one above) - it still needs to compile as a Page so its resources
       (Theme.xaml merge, etc.) are still available. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>
