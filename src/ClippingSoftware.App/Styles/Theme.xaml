<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ClippingSoftware.App.Controls">

    <!--
        Visual identity: a broadcast/capture "control deck", now built on a strict 4-family palette
        (Primary white / Secondary black / Tertiary pale lavender / Neutral near-black, each with a
        tint/shade ramp) plus one functional exception - Alert red - carried over from the tally-lamp
        convention (on-air/recording, and the one destructive action: delete). Tertiary lavender is
        the single "signal" color: connected/live state, focus, selection, hover accents. Nothing
        else borrows color - the rest of the system stays monochrome so the signal always reads.
    -->

    <!-- Primary (white) -->
    <Color x:Key="PrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="PrimaryShadeColor">#FFD8D8D8</Color>

    <!-- Secondary (black) -->
    <Color x:Key="SecondaryColor">#FF000000</Color>

    <!-- Tertiary (pale lavender) - the signal color -->
    <Color x:Key="TertiaryColor">#FFE0E0FF</Color>
    <Color x:Key="TertiaryTintColor">#FFF2F2FF</Color>
    <Color x:Key="TertiaryShadeColor">#FF9A9AD6</Color>

    <!-- Neutral (near-black) ramp - the surface scale -->
    <Color x:Key="NeutralShadeColor">#FF0A0A0A</Color>
    <Color x:Key="NeutralColor">#FF1A1A1A</Color>
    <Color x:Key="NeutralTintColor">#FF242424</Color>
    <Color x:Key="NeutralTint2Color">#FF2E2E2E</Color>
    <Color x:Key="NeutralTint3Color">#FF8A8A90</Color>

    <!-- Alert (red) - recording / destructive actions only, never decoration -->
    <Color x:Key="AlertColor">#FFFF4433</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryShadeBrush" Color="{StaticResource PrimaryShadeColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}"/>
    <SolidColorBrush x:Key="TertiaryTintBrush" Color="{StaticResource TertiaryTintColor}"/>
    <SolidColorBrush x:Key="TertiaryShadeBrush" Color="{StaticResource TertiaryShadeColor}"/>

    <!-- Kept names from the first pass so every existing binding/usage still resolves -->
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource NeutralShadeColor}"/>
    <SolidColorBrush x:Key="DeckBrush" Color="{StaticResource NeutralColor}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource NeutralTint2Color}"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource NeutralTintColor}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="DimBrush" Color="{StaticResource NeutralTint3Color}"/>
    <SolidColorBrush x:Key="TallyRedBrush" Color="{StaticResource AlertColor}"/>

    <!-- Space Mono / Geist aren't installed on this machine yet (verified), so both chains fall back
         to close system equivalents. Installing the real fonts later needs no code change - WPF
         picks up the first family it can resolve at render time. -->
    <FontFamily x:Key="MonoFont">Space Mono, Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="BodyFont">Geist, Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
    </Style>

    <!-- ============ Base surfaces ============ -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PaperBrush}"/>
    </Style>

    <!-- No Foreground setter here, deliberately: a hardcoded value here would out-rank the
         TextElement.Foreground inherited from an ancestor template (GroupBox header, TabItem
         label, PrimaryButtonStyle's black-on-white content) in WPF's property-value precedence,
         since Style setters beat inherited values. Leaving it unset lets those templates' explicit
         TextElement.Foreground actually reach the auto-generated TextBlock; the Window style
         above still sets TextElement.Foreground=PaperBrush as the app-wide default for plain text. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource DeckBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TertiaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TertiaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TertiaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- HotkeyCaptureBox derives from TextBox but is its own runtime type, so it doesn't pick up
         the implicit TextBox style above (implicit-style lookup keys on exact type) - without this
         it renders with the stock white WPF TextBox chrome, clashing with the dark deck everywhere
         else it's used (Settings tab's hotkey fields). -->
    <Style TargetType="{x:Type controls:HotkeyCaptureBox}" BasedOn="{StaticResource {x:Type TextBox}}"/>

    <!-- Flat 16x16 box + tertiary checkmark, replacing the stock OS glyph - checkboxes are everywhere
         now (mute toggles, sound cue toggles, frame-accurate, per-track enable) so this was one of the
         biggest remaining "native control in a custom theme" seams. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" Background="{DynamicResource InkBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M1.5,6.5 L5.5,10.5 L12.5,2.5" Margin="1"
                                  Stroke="{DynamicResource TertiaryBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                            <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource DimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same visual language as CheckBox but a circular indicator/dot, per radio buttons' strong
         established convention (mutual exclusivity reads faster as a dot than a square tick) - used for
         the Settings tab's CAPTURE SOURCE Display/Window mode toggle. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Width="16" Height="16" Fill="{DynamicResource InkBrush}"
                                     Stroke="{DynamicResource HairlineBrush}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource TertiaryBrush}" Opacity="0"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource HairlineBrush}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource DimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ComboBox ============
         Full custom template: the stock combo's bevelled button + white popup was the last "native
         control in a dark theme" seam once CheckBox/RadioButton were flattened - it appears in ~7
         pickers across the Settings tab (capture source/game profiles). Flat hairline border, a hand-drawn chevron
         instead of the OS glyph, and a dark popup with a tertiary-highlighted ComboBoxItem template. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource DeckBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TertiaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                           Content="{TemplateBinding SelectionBoxItem}"
                                           ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                           ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                           Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}"/>

                        <!-- Hand-drawn chevron instead of the OS glyph, kept still (no rotation-on-open
                             animation) to match the rest of the system's understated, non-bouncy motion. -->
                        <Path Data="M1,1 L5,5 L9,1" Stroke="{DynamicResource DimBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>

                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="{DynamicResource DeckBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="280" Margin="0,2,0,0">
                                <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ ScrollBar ============
         ScrollViewer's own stock template just hosts two of these internally, so restyling the type is
         enough to flatten every scrollbar in the app (Settings tab, Clips grid, Profiles edit panel,
         ComboBox popups) without touching ScrollViewer itself. No arrow buttons - a thin track + thumb,
         same minimal language as the Slider, rather than the bulky rounded Win11 default. -->
    <ControlTemplate x:Key="ScrollBarPageButtonTemplate" TargetType="RepeatButton">
        <Rectangle Fill="Transparent"/>
    </ControlTemplate>

    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbChrome" Background="{DynamicResource HairlineBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"
                                              Template="{StaticResource ScrollBarPageButtonTemplate}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"
                                              Template="{StaticResource ScrollBarPageButtonTemplate}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" Width="4" Margin="3,0"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"
                                                      Template="{StaticResource ScrollBarPageButtonTemplate}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"
                                                      Template="{StaticResource ScrollBarPageButtonTemplate}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Height="4" Margin="0,3"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary button (the default): flat, rectangular, no bevel chrome. Hover/focus read as the
         signal lighting up (hairline -> tertiary lavender). -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DeckBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource InkBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button: filled white/black, for the one hero action per screen (Start Recording,
         Save, Export, Add) - the highest-contrast option in the system, reserved for that role. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TertiaryBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryShadeBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HairlineBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outlined button: transparent, for secondary actions that shouldn't compete with a Primary
         button on the same row (Close, Refresh, Set-from-playhead). -->
    <Style x:Key="OutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <!-- Destructive-action variant (Delete buttons): border/label read as the Alert-red "hot" signal
         instead of default gray, so the dangerous action is visually distinct at a glance. -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BorderBrush" Value="{DynamicResource TallyRedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TallyRedBrush}"/>
    </Style>

    <!-- Sub-nav pill (Clips page's LIBRARY/EDIT/TAGS row): a shared base so all sub-nav buttons read as
         one coherent group - transparent by default with a dim label, no filled chrome until selected.
         Each usage adds its own DataTrigger for which CurrentView value means "this one is selected"
         (a Style's Setters can't parameterize per-instance), but every trigger sets the same two things -
         Foreground to Primary (white) and BorderBrush to the Tertiary signal color as a bottom-edge
         accent - so the selected state reads identically everywhere it's used. -->
    <Style x:Key="SubNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon-only action button (folder/trim/delete on clip cards): a plain square hit-target, no
         chrome until hovered - the icon glyph itself (drawn per-use as a Path) carries the meaning,
         with a ToolTip for the label, matching the "pencil icon-only" pattern from the component kit. -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Left rail QUIT button ============
         Overlaid on the TabControl's own rail column at runtime (MainWindow.xaml), not baked into the
         TabControl ControlTemplate above - that template is a generic reusable style, this button is a
         one-off tied to window lifecycle (see MainWindow.xaml.cs's Quit_Click). Idle state blends into
         the rail (DeckBrush background, same as the unselected tab items' Chrome) with red text as the
         one hint of what it does; hover commits to it fully - solid red fill, dark text - the same
         "close button turns solid red on hover" convention TitleBarCloseButtonStyle already uses, so
         the two real "this ends something" actions in the app read as the same gesture. -->
    <Style x:Key="QuitRailButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DeckBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TallyRedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Padding" Value="0,14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TallyRedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Custom titlebar caption buttons (M15) ============
         Minimize/maximize sit flat until hovered, same "chrome appears on hover" language as
         IconButtonStyle; Close follows the one universal Windows convention worth keeping - it turns
         solid Alert-red with a white glyph on hover, so the one truly destructive caption action still
         reads as different from the other two even inside this app's otherwise-monochrome system. -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon glyph inside is drawn with a fixed light stroke (see MainWindow.xaml) so it stays legible
         on both the idle dark background and the red hover background below - no separate hover-swap
         needed on the icon itself, only the chrome behind it changes. -->
    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TallyRedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox: flatten the stock sunken/beveled chrome into a hairline-bordered deck panel with
         a small dim monospace eyebrow instead of the OS-themed gray caption. -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0" ContentSource="Header" Margin="0,0,0,6"
                                          HorizontalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource DimBrush}"
                                          TextElement.FontFamily="{StaticResource MonoFont}"
                                          TextElement.FontSize="11"/>
                        <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource DeckBrush}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabControl restyled as the app's primary navigation shell: a left icon rail (M15 - moved off the
         cramped bottom strip, VS Code activity-bar pattern), each TabItem a deck-selector cell with an
         icon+label header (set per-tab in MainWindow.xaml) rather than the stock OS tab chrome. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <!-- Full override, not just Background/BorderThickness setters: the stock template's
                         tab-strip column ignores those and stays OS-white, leaving a pale bar next to the
                         tabs. Explicitly backing the TabPanel column closes that gap. -->
                    <Grid Background="{DynamicResource InkBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource DeckBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                            <TabPanel IsItemsHost="True" Width="72"/>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource InkBrush}">
                            <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
        <Setter Property="Padding" Value="0,16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Rail item: the selected indicator sits on the item's LEFT edge (an activity-bar
                         accent bar), not the old bottom-nav's top-edge underline. -->
                    <Border x:Name="Chrome" Background="{DynamicResource DeckBrush}"
                            BorderBrush="Transparent" BorderThickness="3,0,0,0">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TertiaryBrush}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Data grid (Profiles list) ============ -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource DeckBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource DeckBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource DeckBrush}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="RowHeight" Value="30"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource HairlineBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource HairlineBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Slider ============
         Flattened to a thin track + small pill thumb, tertiary-lavender fill for the "played"/filled
         portion - reads as a scrub bar or fader on a capture deck rather than the stock Windows groove
         slider. Originally sized for the Trim Editor's wide scrub bar; also now used for the compact
         volume sliders on Capture-tab audio rows and per-track Trim Editor rows, so the thumb is sized
         small enough to read well at both widths rather than looking oversized on a ~150px control. -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="3" Background="{DynamicResource HairlineBrush}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{DynamicResource TertiaryBrush}" Height="3"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="3"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="8" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbChrome" Background="{StaticResource PrimaryBrush}" CornerRadius="4"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TertiaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource TertiaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Progress bar ============
         Left as the stock WPF template (just recolored) rather than a custom one: nothing in the
         app surfaces a real progress/storage value yet (no fabricated cloud-storage meter here -
         see the design-pass notes), so there's no live case to build and verify a custom indicator
         against. Add a proper ControlTemplate when a real bound value exists to test it with. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
